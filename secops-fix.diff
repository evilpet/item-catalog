diff --git a/app.py b/app.py
index 095d229..5d7d091 100644
--- a/app.py
+++ b/app.py
@@ -18,9 +18,11 @@ def init_db():
 def search(name):
     """Return items whose name matches. (Public API used by the search endpoint.)"""
     conn = sqlite3.connect(DB)
-    # Build the query by embedding the user-supplied name.
-    query = "SELECT id, name, price FROM items WHERE name = '" + name + "'"
-    rows = conn.execute(query).fetchall()
+    # Parameterized query: the user-supplied name is bound as a value, never
+    # interpolated into the SQL text, which prevents SQL injection (CWE-89).
+    rows = conn.execute(
+        "SELECT id, name, price FROM items WHERE name = ?", (name,)
+    ).fetchall()
     conn.close()
     return rows
 
